{
  "name": "ginkgo-notes",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning --watch server/index.ts",
    "start": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "serve:prod": "vite build && node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p server --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-code-block": "3.33.0",
    "@tiptap/extension-code-block-lowlight": "^3.33.0",
    "@tiptap/extension-details": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "highlight.js": "11.11.2",
    "html2canvas-pro": "^2.6.4",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "nodemailer": "^10.5.0",
    "prettier": "3.9.10",
    "uqr": "^0.1.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
