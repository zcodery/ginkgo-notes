# 复制为 .env 后按需填写；所有变量都是可选的，不填则用程序内默认值。

# ---- 服务端口与数据目录 ----
# 后端端口（前端 Vite 默认 3100，会把 /api 代理到这里的端口）
PORT=3101
# 数据目录（SQLite 库、JWT 密钥都放这里；默认 server/data）
GINKGO_DATA_DIR=server/data
# 对外可访问地址，用于生成分享链接等绝对 URL（可选）
PUBLIC_URL=http://localhost:3100

# ---- 首个管理员账号 ----
# 仅当库里还没有任何管理员时生效。请务必在首次启动前改成自己的账号密码！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你自己的强密码

# ---- JWT 密钥 ----
# 留空则自动生成并写入数据目录的 app_meta 表（多进程/重启间保持一致）。
# 用固定环境变量可在多副本部署时显式共享同一把密钥。
# JWT_SECRET=

# ---- AI（OpenAI 兼容接口）----
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ---- 邮件通知（SMTP）----
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Ginkgo Notes <noreply@example.com>

# ---- GitHub OAuth（如需用 GitHub 登录）----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
